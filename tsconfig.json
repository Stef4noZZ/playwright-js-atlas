{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@framework/*": ["framework/*"],
      "@config/*": ["config/*"]
    },
    "types": ["node"]
  },
  "include": ["framework", "tests", "config", "playwright.config.ts"],
  "exclude": ["tests/unit"]
}
